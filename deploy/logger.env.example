# /etc/neuract/logger.env — environment for BOTH systemd units
# (neuract-job-runner.service and loggerfast-api.service).
#
#   sudo install -d -m 0750 -o root -g neuract /etc/neuract
#   sudo install -m 0640 -o root -g neuract deploy/logger.env.example /etc/neuract/logger.env
#   sudo $EDITOR /etc/neuract/logger.env   # fill in real values
#
# This file contains credentials — keep it root-owned, mode 0640.

# --- Shared: metadata (App) DB -------------------------------------------
# REQUIRED. The Rust engine refuses to start without it.
APP_DB_URL=postgresql://logger:CHANGEME@127.0.0.1:5432/neuract_meta

# --- Rust engine (neuract-job-runner) ------------------------------------
# Bench/observability metrics DB (engine creates the bench_metrics table).
BENCH_DB_URL=postgresql://logger:CHANGEME@127.0.0.1:5432/loggerfast_metrics
# How often the engine polls app_jobs for started/stopped jobs (ms).
JOB_POLL_MS=2000
# Engine log level (error|warn|info|debug|trace).
RUST_LOG=info
# Where the engine writes its error CSV (error_log_rust.csv). Must be
# writable by the 'neuract' user.
RUST_BENCH_LOG_DIR=/var/log/neuract
# Log rotation knobs (rotating file writer inside the engine):
#   per-file size cap in MB (default 100) and rotated backups kept (default 5).
LOGGER_LOG_MAX_MB=100
LOGGER_LOG_BACKUPS=5
# Error-CSV size cap in MB before it rolls to a single .1 backup (default 50).
LOGGER_ERROR_CSV_MAX_MB=50
# Max rows buffered per table while the target DB is down (M11; default 10000).
# Oldest rows are dropped (loudly logged + error-CSV'd) beyond this cap.
BATCH_BUFFER_CAP_ROWS=10000
# Where the engine posts trigger notifications (the API below).
API_BASE_URL=http://127.0.0.1:5175

# --- FastAPI control plane (loggerfast-api) ------------------------------
# AI pipeline: leave LOGGER_ENABLE_AI UNSET (or set to 0) => AI is OFF.
# Only set to 1 on installations that intentionally run the AI endpoints.
#LOGGER_ENABLE_AI=1

# CORS (M14): comma-separated EXACT browser origins allowed to call the API.
# REQUIRED in production — without it the dev fallback applies.
LOGGER_CORS_ORIGINS=https://logger.example.com

# Keycloak
KC_URL=https://keycloak.example.com/keycloak
KC_REALM=desktop
KC_ADMIN_CLIENT_ID=neuract_owner
KC_ADMIN_CLIENT_SECRET=CHANGEME
# Token hardening (M13): comma-separated client IDs (azp) trusted to call
# this API. Strongly recommended in production.
KC_REQUIRED_AZP=loggerfast-frontend

# Redis (notification WebSocket broadcasting)
REDIS_URL=redis://127.0.0.1:6379/3
