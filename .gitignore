# Top-level Git ignore for PLC Logger project

# OS / General
*.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*.swo
*.orig

# Editor settings
.vscode/
.idea/

# Environment files (keep secrets out of VCS)
.env
.env.*
*.env

# Logs
*.log
logs/

# Databases and local data
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
.venv/
venv/

# PyInstaller outputs (dist tracked)
build/

# Node / Vite (apps/desktop)
apps/desktop/node_modules/
apps/desktop/.vite/
apps/desktop/.eslintcache

# Rust / Tauri (apps/desktop/src-tauri)
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Rust jobs data outputs (benchmarks, reports)
agent/rust_jobs/**/*.csv
agent/rust_jobs/**/*.xlsx
agent/rust_jobs/**/*.png
agent/rust_jobs/**/*.log

# Rust jobs toolchain caches
agent/rust_jobs/target/
agent/rust_jobs/vcpkg/

# WiX / Installer artifacts
installer/**/*.wixobj
installer/**/*.wixpdb
installer/**/*.wixout
installer/**/*.wixproj.user
installer/**/*.wixproj.bin
installer/**/*.cab
installer/**/*.msi

# PowerShell transient files
*.ps1xml

# Repo-local scratch files (seen in this project)
/tmp_*
/query*
/qc
/file


# Tray build outputs
build-tray/


target/
**/target/
*.pdb
*.rlib
*.rmeta

# MFM source PDFs (local to deployment, not versioned)
agent/data/mfm_docs/

# E2E test assets: prebuilt Rust engine binary (~14MB) must not be committed
agent/tests/bin/

# SEC-1: OPC UA client PKI material (auto-generated by the opcua crate via
# create_sample_keypair; per-deployment secret — never commit. The currently
# tracked private.pem/cert.der are compromised and must be rotated.
agent/rust_jobs/pki/

# Runtime lockfiles (PID/port, written each boot)
agent.lock.json
agent.dev.lock.json
# Playwright MCP scratch
.playwright-mcp/
